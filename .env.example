# ─────────────────────────────────────────────
# SportBook UA — Environment Variables Template
# Copy to .env and fill in real values
# NEVER commit .env to git
# ─────────────────────────────────────────────

# ── Database ──────────────────────────────────
DATABASE_URL=postgresql://sportbook:sportbook@localhost:5432/sportbook

# ── Security ──────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars

# ── Application ───────────────────────────────
# Token lifetime in minutes (default: 1440 = 24h)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Max upload file size in bytes (default: 5MB)
MAX_FILE_SIZE=5242880

# Directory for uploaded images
UPLOAD_DIR=uploads

# ── CORS ──────────────────────────────────────
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000

# ── Docker / Postgres (used in docker-compose) ─
POSTGRES_USER=sportbook
POSTGRES_PASSWORD=sportbook
POSTGRES_DB=sportbook
